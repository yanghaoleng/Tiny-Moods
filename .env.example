ARK_API_KEY=
SEEDREAM_LITE_API_KEY=
SEEDREAM_PRO_API_KEY=
SEEDREAM_DEFAULT_TIER=pro
SEEDREAM_LITE_MODEL=doubao-seedream-5-0-260128
SEEDREAM_LITE_SIZE=2K
SEEDREAM_LITE_PRICE_CNY=0.22
SEEDREAM_PRO_MODEL=doubao-seedream-5-0-pro-260628
SEEDREAM_PRO_SIZE=2144x2144
SEEDREAM_PRO_PRICE_CNY=0.60

# 运营后台：访问 /admin 后使用该密码登录。生产环境必须设置强密码。
ADMIN_PASSWORD=
# 可选。设置后即使修改 ADMIN_PASSWORD，已签发会话的签名策略也保持独立。
ADMIN_SESSION_SECRET=
# 可选。只用于把访问 IP 单向转换为每日匿名摘要，不保存原始 IP。
ANALYTICS_SALT=

# 生产数据目录，生成记录、图片和埋点都保存在这里。
DATA_ROOT=/var/lib/9face

# 虎皮椒会为微信和支付宝分别发放 APPID 与 APPSECRET。
XUNHU_WECHAT_APP_ID=
XUNHU_WECHAT_APP_SECRET=
XUNHU_ALIPAY_APP_ID=
XUNHU_ALIPAY_APP_SECRET=
XUNHU_GATEWAY=https://api.xunhupay.com/payment/do.html
